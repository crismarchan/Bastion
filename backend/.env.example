# Puerto del servidor local
PORT=3000

# Connection string de Supabase (Project Settings -> Database -> Connection string -> URI)
# Reemplaza USUARIO, PASSWORD y HOST por los tuyos. NUNCA subas este archivo a Git.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:6543/postgres

# Clave secreta para firmar los JWT (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-en-produccion
